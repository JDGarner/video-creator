{
  "name": "video-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic explainer videos: script + data in, MP4 out",
  "scripts": {
    "dev": "remotion studio",
    "still": "remotion still",
    "typecheck": "tsc --noEmit",
    "lint:theme": "node scripts/check-hex.mjs",
    "test": "vitest run",
    "check": "tsx scripts/short.ts check",
    "narrate": "tsx scripts/short.ts narrate",
    "align": "tsx scripts/short.ts align",
    "render": "tsx scripts/short.ts render",
    "bundle": "tsx scripts/short.ts bundle",
    "stills": "tsx scripts/short.ts stills",
    "asset": "tsx scripts/asset.ts",
    "docs:scenes": "tsx scripts/scene-docs.ts",
    "sfx": "tsx scripts/sfx.ts",
    "trim": "tsx scripts/trim.ts",
    "short": "tsx scripts/short.ts short"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/captions": "4.0.541",
    "@remotion/install-whisper-cpp": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/zod-types": "4.0.541",
    "d3-geo": "3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.541",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "4.6.7"
  }
}
